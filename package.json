{
  "name": "pluto-store",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:orders": "tsx scripts/seed-orders.ts",
    "compare:images": "node --conditions=react-server --import tsx scripts/compare-image-variants.ts",
    "trim:references": "node --import tsx scripts/trim-reference-padding.ts",
    "backfill:dimensions": "node --import tsx scripts/backfill-reference-dimensions.ts",
    "remove:orphan-examples": "node --import tsx scripts/remove-orphan-examples.ts",
    "mockups:scenes": "node --import tsx scripts/generate-mockup-scenes.ts",
    "test:browser": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.45.0",
    "motion": "^14.2.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "openai": "^7.15.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/compat": "^2.1.1",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "supabase": "^2.72.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
