NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1696x2400
OPENAI_IMAGE_QUALITY=xhigh
OPENAI_MAX_REFERENCE_IMAGES=15
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook endpoint (account.updated events for
# creators' payout accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Bearer token Vercel Cron sends to /api/cron/payouts.
CRON_SECRET=

GELATO_API_KEY=
GELATO_API_BASE_URL=https://order.gelatoapis.com/v4
GELATO_PRODUCT_API_BASE_URL=https://product.gelatoapis.com/v3
GELATO_ORDER_TYPE=draft
FULFILLMENT_MODE=manual

ADMIN_USER_IDS=
GENERATION_ALTERNATIVES=3
MAX_GENERATION_ROUNDS=2
UPLOADS_PER_HOUR=5
GENERATIONS_PER_DAY=100
RATE_LIMIT_SALT=replace-with-a-random-secret
MAX_PRINT_UPSCALE=1.5
MIN_PRINT_DPI=144
RETENTION_DAYS=30
# Seed only: create a creator auth user first, then set their UUID.
SEED_CREATOR_USER_ID=

# Development only. Set to a Supabase user UUID to skip the magic-link sign-in
# and treat every request as that user. Ignored unless NODE_ENV=development, and
# stripped from production builds. Use the same id as SEED_CREATOR_USER_ID so
# the dashboard finds a store.
DEV_AUTH_USER_ID=
DEV_AUTH_EMAIL=
